# 生产环境变量配置模板
# 
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 填写正确的生产环境 API 地址
# 3. 重新构建：npm run build
#
# 注意：
# - Vite 只会在构建时读取 .env.production
# - 运行时不会读取环境变量
# - 所有环境变量必须以 VITE_ 开头才能在代码中访问

# Workshop 后端 API 地址
VITE_API_URL=https://api.feitianchengzi.com/workshop/v1

# API Gateway 地址
VITE_GATEWAY_URL=https://api.feitianchengzi.com

# 部署路径（根路径部署用 /，子路径部署例如 /console）
VITE_PUBLIC_BASE=/

# 反馈 SDK（固定使用线上 SDK 与线上网关）
# 不要提交真实 Key；由部署环境注入。SDK 会将当前已登录用户作为反馈归属。
# V2 发布并验收后，设置为：https://feedback.feitianchengzi.com/sdk-v2/index.html?embed=web
# 留空时会继续使用稳定的 V1 `/sdk`，避免 V2 未发布时控制台入口不可用。
VITE_FEEDBACK_SDK_URL=
VITE_FEEDBACK_SDK_API_KEY=
VITE_FEEDBACK_SDK_PROJECT_ID=78

# V2 灰度项目 ID，逗号分隔。仅这些项目改用独立的 Workshop V2 feedback client；留空则全部保持 V1。
# V2 项目由控制台 JWT 交换短期反馈会话 token，不使用 VITE_FEEDBACK_SDK_API_KEY。
VITE_FEEDBACK_V2_PROJECT_IDS=

# 可选：默认从 VITE_API_URL 推导为 /workshop/v2。
# VITE_WORKSHOP_V2_API_URL=https://api.feitianchengzi.com/workshop/v2
