# OSS 部署配置
# 复制此文件为 .env 并填入实际配置

# 阿里云 OSS AccessKey ID
OSS_ACCESS_KEY_ID=

# 阿里云 OSS AccessKey Secret
OSS_ACCESS_KEY_SECRET=

# OSS Endpoint（根据你的 Bucket 地域选择）
# 示例：
# - 华东1（杭州）: http://oss-cn-hangzhou.aliyuncs.com
# - 华东2（上海）: http://oss-cn-shanghai.aliyuncs.com
# - 华北1（青岛）: http://oss-cn-qingdao.aliyuncs.com
# - 华北2（北京）: http://oss-cn-beijing.aliyuncs.com
# - 华南1（深圳）: http://oss-cn-shenzhen.aliyuncs.com
OSS_ENDPOINT=http://oss-cn-beijing.aliyuncs.com

# OSS Bucket 名称
OSS_BUCKET_NAME=feitianchengziworkshop


# Vite 环境变量（用于构建）
VITE_API_URL=https://api.feitianchengzi.com/workshop/v1
VITE_GATEWAY_URL=https://api.feitianchengzi.com
# 部署路径（根路径部署用 /，子路径部署例如 /console）
VITE_PUBLIC_BASE=/

# 前端 OSS 配置（用于头像上传）
# OSS 区域（如：oss-cn-hangzhou, oss-cn-beijing）
VITE_OSS_REGION=oss-cn-hangzhou
# OSS Bucket 名称
VITE_OSS_BUCKET=feitianchengziworkshop

# OSS 自定义域名（可选，用于显示访问地址）
OSS_CUSTOM_DOMAIN=https://workshop.feitianchengzi.com

# 可选：根 index.html 跳转目标（publish-root-index 脚本使用）
ROOT_INDEX_TARGET=/console
