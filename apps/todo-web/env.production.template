# 生产环境变量配置模板
# 
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 填写正确的生产环境 API 地址
# 3. 重新构建：npm run build
#
# 注意：
# - Vite 只会在构建时读取 .env.production
# - 运行时不会读取环境变量
# - 所有环境变量必须以 VITE_ 开头才能在代码中访问

# Workshop 后端 API 地址
VITE_API_URL=https://api.feitianchengzi.com/workshop/v1

# API Gateway 地址
VITE_GATEWAY_URL=https://api.feitianchengzi.com

