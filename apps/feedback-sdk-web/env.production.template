# 生产环境变量模板（复制为 .env.production）

# 网关地址
VITE_GATEWAY_URL=https://api.feitianchengzi.com

# 部署路径：
# 1) 当前 OSS bucket 与 console 共域部署：/sdk
# 2) 独立域名根路径部署时再改为：/
VITE_PUBLIC_BASE=/sdk

# 同域部署时无需设置。跨域 iframe 必须在构建时列出真实宿主 origin，
# 否则首次 configure 消息会被拒绝，无法靠该消息里的 parentOrigins 自行授权。
# 本地跨端口验收也须显式列出，例如 http://localhost:13101。
# VITE_SDK_PARENT_ORIGIN=
# 多个受控宿主页面可用逗号分隔（优先于 VITE_SDK_PARENT_ORIGIN）。
# VITE_SDK_PARENT_ORIGINS=https://workshop.feitianchengzi.com,https://feedback.feitianchengzi.com,https://jinghong.wang

# 可选：预置 API Key（更推荐由接入方通过 SDK 初始化或 iframe 消息桥注入）
# VITE_SDK_FEEDBACK_API_KEY=

# 可选：预置项目 ID（若后端仍要求 project_id，可在这里配置）
# VITE_SDK_FEEDBACK_PROJECT_ID=

# V2 不允许通过构建环境注入 API Key 或反馈会话 token。
# 宿主服务应在运行时调用 window.FeedbackSDK.configure({
#   feedbackV2Enabled: true, feedbackSessionToken: 'fbs_...' })。
