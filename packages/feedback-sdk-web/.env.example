# SDK生产环境配置
# 复制此文件为 .env 并填写实际值

# 网关地址
VITE_GATEWAY_URL=https://api.feitianchengzi.com

# 部署路径
VITE_PUBLIC_BASE=/sdk

# 阿里云OSS配置（部署时需要）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=sdk

# 部署选项
ALLOW_ROOT_DEPLOY=0
SYNC_ROOT_INDEX=1
ROOT_INDEX_TARGET=/console