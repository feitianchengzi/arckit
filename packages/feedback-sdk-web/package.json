{
  "name": "@arckit/feedback-sdk-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "build:v2": "VITE_PUBLIC_BASE=/sdk-v2 vite build",
