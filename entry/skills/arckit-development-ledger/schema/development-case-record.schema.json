{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.local/schema/development-case-record.schema.json",
  "title": "Arckit Development Case Record",
  "type": "object",
  "required": ["schema_version", "id", "title", "status", "artifact_type", "created_at", "updated_at", "user_intent", "expected_outcome", "project_state_ref", "current_round", "facts", "state_impacts", "gaps", "content_revision", "completion_review", "open_questions", "decisions", "pending_handoffs", "process_notes", "rounds", "case_resolution", "project_impact_candidate"],
  "properties": {
    "schema_version": { "const": "development-case-record/v4" },
    "id": { "type": "string", "pattern": "^CASE-[0-9]{8}-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "blocked", "handoff", "closed"] },
    "artifact_type": { "type": "string", "enum": ["code", "skill", "document", "workflow", "mixed", "unknown"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "user_intent": { "type": "string" },
    "expected_outcome": { "type": "string" },
    "project_state_ref": { "type": "string", "minLength": 1 },
    "current_round": { "type": "object" },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "state_impacts": { "type": "array", "items": { "$ref": "#/$defs/state_impact" } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/dynamic_gap" } },
    "content_revision": { "type": "integer", "minimum": 0 },
    "completion_review": { "$ref": "#/$defs/completion_review" },
    "open_questions": { "type": "array" },
    "decisions": { "type": "array" },
    "pending_handoffs": { "type": "array" },
    "process_notes": { "type": "array" },
    "rounds": { "type": "array" },
    "case_resolution": { "type": "object" },
    "project_impact_candidate": { "$ref": "#/$defs/project_impact_candidate" }
  },
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["id", "revision", "status", "statement", "basis", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["accepted", "superseded"] },
        "statement": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "state_impact": {
      "type": "object",
      "required": ["id", "fact_id", "fact_revision", "condition_ref", "effect", "reason", "gap_ids", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fact_id": { "type": "string", "minLength": 1 },
        "fact_revision": { "type": "integer", "minimum": 1 },
        "condition_ref": { "type": "string", "minLength": 3 },
        "effect": { "type": "string", "enum": ["upheld", "threatened", "undetermined"] },
        "reason": { "type": "string", "minLength": 1 },
        "gap_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "dynamic_gap": {
      "type": "object",
      "required": ["id", "status", "goal", "reason", "derived_from", "blocked_by", "priority_basis", "responsibility", "evidence_required", "resolution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["open", "resolved", "cancelled"] },
        "goal": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "derived_from": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "blocked_by": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "priority_basis": { "type": "object", "minProperties": 1 },
        "responsibility": { "type": "string", "enum": ["agent", "human", "external"] },
        "evidence_required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "resolution": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "completion_review": {
      "type": "object",
      "required": ["status", "policy", "additional_cycles_authorized", "cycle_count", "reviewed_content_revision", "dimensions", "findings", "cycles", "evidence", "escalation", "human_authorizations"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "findings_open", "clean", "needs_human"] },
        "dimensions": {
          "type": "object",
          "required": ["implementation_correctness", "problem_resolution", "verification_credibility", "regression_risk", "minimality"]
        }
      }
    },
    "project_impact_candidate": {
      "type": "object",
      "required": ["status", "changes", "condition_changes", "evidence"],
      "properties": {
        "status": { "type": "string", "enum": ["none", "proposed", "accepted"] },
        "changes": { "type": "array" },
        "condition_changes": { "type": "array" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
