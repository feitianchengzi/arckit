{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.local/schema/iteration-state-record.schema.json",
  "title": "Arckit Iteration State Record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "created_at",
    "updated_at",
    "iteration_goal",
    "project_state_ref",
    "target_project_states",
    "accepted_project_changes",
    "acceptance",
    "blocking_project_gaps",
    "active_case_refs",
    "closed_case_refs",
    "close_condition",
    "last_case_aggregation"
  ],
  "properties": {
    "schema_version": { "const": "iteration-state-record/v2" },
    "id": { "type": "string", "pattern": "^ITER-[0-9]{8}-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["planned", "active", "blocked", "closed"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "iteration_goal": { "type": "string" },
    "project_state_ref": { "type": "string", "minLength": 1 },
    "target_project_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/target_project_state" }
    },
    "accepted_project_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/accepted_project_change" }
    },
    "acceptance": {
      "type": "object",
      "required": ["status", "evidence", "remaining_project_gaps"],
      "properties": {
        "status": { "type": "string", "enum": ["working", "verified", "accepted", "blocked"] },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "remaining_project_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "blocking_project_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "active_case_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "closed_case_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "close_condition": { "type": "string" },
    "last_case_aggregation": {
      "type": "object",
      "required": ["case_ref", "project_changes", "evidence", "updated_at"],
      "properties": {
        "case_ref": { "type": "string" },
        "project_changes": { "type": "array", "items": { "$ref": "#/$defs/project_change_summary" } },
        "condition_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "dimension", "condition_id"],
            "properties": {
              "action": { "type": "string", "enum": ["add", "update", "retire"] },
              "dimension": { "type": "string", "minLength": 1 },
              "condition_id": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "updated_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "state_value": {
      "type": "string",
      "enum": [
        "unknown",
        "not_required",
        "needed",
        "defined",
        "designed",
        "implemented",
        "integrated",
        "verified",
        "accepted",
        "released",
        "operational",
        "deferred",
        "blocked"
      ]
    },
    "target_project_state": {
      "type": "object",
      "required": ["dimension", "target_state", "reason"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "target_state": { "$ref": "#/$defs/state_value" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "accepted_project_change": {
      "type": "object",
      "required": ["dimension", "from_state", "to_state", "reason", "evidence", "case_ref"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "from_state": { "$ref": "#/$defs/state_value" },
        "to_state": { "$ref": "#/$defs/state_value" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "case_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "project_change_summary": {
      "type": "object",
      "required": ["dimension", "from_state", "to_state"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "from_state": { "$ref": "#/$defs/state_value" },
        "to_state": { "$ref": "#/$defs/state_value" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
