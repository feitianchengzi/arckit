{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "selection_assessment": {
      "type": "object",
      "required": [
        "context_ref",
        "scope",
        "maintenance_object",
        "implementation_carriers",
        "activation",
        "verification",
        "conclusion_kind",
        "invariant_refs",
        "acceptance",
        "prerequisites",
        "expected_fact_refs",
        "establishes_expectations",
        "delivers_realization",
        "boundary_reason",
        "deferred"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "maintenance_object": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation_carriers": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "activation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "conclusion_kind": {
          "type": "string",
          "enum": [
            "exploration",
            "establishment"
          ]
        },
        "invariant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "status",
              "evidence"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "satisfied",
                  "unresolved"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "additionalProperties": false
          }
        },
        "expected_fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "establishes_expectations": {
          "type": "boolean"
        },
        "delivers_realization": {
          "type": "boolean"
        },
        "boundary_reason": {
          "type": "string",
          "minLength": 1
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "context_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^case:round:[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "semantic_case_command": {
      "type": "object",
      "required": [
        "schema_version",
        "case_id",
        "selection",
        "planned_transition",
        "fresh_gap",
        "claim",
        "project_claim",
        "invariant_assessment",
        "evidence",
        "unresolved",
        "round_outcome"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "arckit-semantic-case-command/v1"
        },
        "case_id": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/semantic_selection"
        },
        "planned_transition": {
          "type": "object",
          "required": [
            "goal",
            "expected_state_change",
            "selection_assessment"
          ],
          "properties": {
            "goal": {
              "type": "string"
            },
            "expected_state_change": {
              "type": "string"
            },
            "selection_assessment": {
              "$ref": "#/$defs/selection_assessment"
            }
          },
          "additionalProperties": false
        },
        "fresh_gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/semantic_gap"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim": {
          "$ref": "#/$defs/semantic_claim"
        },
        "project_claim": {
          "$ref": "#/$defs/semantic_project_claim"
        },
        "invariant_assessment": {
          "$ref": "#/$defs/semantic_invariant_assessment"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "round_outcome": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "blocked",
            "needs_human",
            "external_wait"
          ]
        }
      },
      "additionalProperties": false
    },
    "semantic_selection": {
      "type": "object",
      "required": [
        "basis",
        "snapshot_token",
        "selected_ref",
        "comparison_summary",
        "fresh_discovery_summary",
        "considered"
      ],
      "properties": {
        "basis": {
          "type": "string"
        },
        "snapshot_token": {
          "type": "string"
        },
        "selected_ref": {
          "type": "string"
        },
        "comparison_summary": {
          "type": "string"
        },
        "fresh_discovery_summary": {
          "type": "string"
        },
        "considered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_considered_candidate"
          }
        }
      },
      "additionalProperties": false
    },
    "semantic_considered_candidate": {
      "type": "object",
      "required": [
        "ref",
        "source",
        "eligibility",
        "disposition",
        "priority_basis",
        "reason"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "persisted",
            "fresh"
          ]
        },
        "eligibility": {
          "type": "string",
          "enum": [
            "ready",
            "case_required",
            "blocked",
            "ineligible"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "selected",
            "deferred",
            "excluded"
          ]
        },
        "priority_basis": {
          "$ref": "#/$defs/priority_basis"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "priority_basis": {
      "type": "object",
      "required": [
        "blocking",
        "uncertainty",
        "risk",
        "user_impact"
      ],
      "properties": {
        "blocking": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        },
        "user_impact": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "semantic_gap": {
      "type": "object",
      "required": [
        "ref",
        "goal",
        "reason",
        "derived_from",
        "blocked_by",
        "priority_basis",
        "responsibility",
        "evidence_required"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^local:gap:.+$"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority_basis": {
          "$ref": "#/$defs/priority_basis"
        },
        "responsibility": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "external"
          ]
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "One independently resolvable question or uncertainty, selected for its current importance to the authorized task. Do not bundle independent product, interaction, visual or technical decisions under the final task outcome."
    },
    "semantic_claim": {
      "type": "object",
      "required": [
        "resolve_selected_gap",
        "facts_added",
        "facts_superseded",
        "impacts_added",
        "impacts_updated",
        "gaps_added",
        "gaps_cancelled",
        "resolved_open_questions",
        "completed_handoffs",
        "completion_review_result",
        "resolved_review_findings",
        "review_budget_extension"
      ],
      "properties": {
        "resolve_selected_gap": {
          "description": "Resolution claim for a selected ordinary Case Gap. Must be null for a Completion Review candidate, which is completed only by completion_review_result or an independent review_budget_extension.",
          "anyOf": [
            {
              "$ref": "#/$defs/semantic_resolution"
            },
            {
              "type": "null"
            }
          ]
        },
        "facts_added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_fact"
          }
        },
        "facts_superseded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_fact_supersession"
          }
        },
        "impacts_added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_impact"
          }
        },
        "impacts_updated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_impact"
          }
        },
        "gaps_added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_gap"
          }
        },
        "gaps_cancelled": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_gap_cancellation"
          }
        },
        "resolved_open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed_handoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completion_review_result": {
          "description": "The only completion claim for a selected Completion Review candidate. It must be null for ordinary Case Gaps and cannot be combined with Case content mutations or review_budget_extension.",
          "anyOf": [
            {
              "$ref": "#/$defs/semantic_completion_review_result"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_review_findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_budget_extension": {
          "anyOf": [
            {
              "$ref": "#/$defs/review_budget_extension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "semantic_resolution": {
      "type": "object",
      "required": [
        "outcome",
        "reason",
        "evidence"
      ],
      "properties": {
        "outcome": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "semantic_fact": {
      "type": "object",
      "required": [
        "ref",
        "statement",
        "basis",
        "evidence"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^local:fact:.+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "description": "An evidence-backed observation or conclusion. Accepting it does not resolve every new deficit it reveals."
    },
    "semantic_fact_supersession": {
      "type": "object",
      "required": [
        "fact_ref",
        "reason",
        "evidence"
      ],
      "properties": {
        "fact_ref": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "semantic_impact": {
      "type": "object",
      "required": [
        "ref",
        "fact_ref",
        "target_ref",
        "effect",
        "reason",
        "gap_refs",
        "evidence"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "fact_ref": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        },
        "effect": {
          "type": "string",
          "enum": [
            "upheld",
            "threatened",
            "undetermined"
          ]
        },
        "reason": {
          "type": "string"
        },
        "gap_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "semantic_gap_cancellation": {
      "type": "object",
      "required": [
        "gap_ref",
        "outcome",
        "reason",
        "evidence"
      ],
      "properties": {
        "gap_ref": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "semantic_completion_review_result": {
      "type": "object",
      "required": [
        "outcome",
        "reviewer",
        "dimensions",
        "findings",
        "evidence"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "clean",
            "findings",
            "needs_human"
          ]
        },
        "reviewer": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        },
        "dimensions": {
          "$ref": "#/$defs/review_dimensions"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_review_finding"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "review_dimensions": {
      "type": "object",
      "required": [
        "implementation_correctness",
        "problem_resolution",
        "verification_credibility",
        "regression_risk",
        "minimality"
      ],
      "properties": {
        "implementation_correctness": {
          "type": "string",
          "enum": [
            "clean",
            "findings"
          ]
        },
        "problem_resolution": {
          "type": "string",
          "enum": [
            "clean",
            "findings"
          ]
        },
        "verification_credibility": {
          "type": "string",
          "enum": [
            "clean",
            "findings"
          ]
        },
        "regression_risk": {
          "type": "string",
          "enum": [
            "clean",
            "findings"
          ]
        },
        "minimality": {
          "type": "string",
          "enum": [
            "clean",
            "findings"
          ]
        }
      },
      "additionalProperties": false
    },
    "semantic_review_finding": {
      "type": "object",
      "required": [
        "ref",
        "kind",
        "statement",
        "responsibility",
        "artifact_refs",
        "evidence"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "error",
            "omission",
            "excess"
          ]
        },
        "statement": {
          "type": "string"
        },
        "responsibility": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "external"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "review_budget_extension": {
      "type": "object",
      "required": [
        "additional_cycles",
        "authorized_by",
        "reason",
        "evidence"
      ],
      "properties": {
        "additional_cycles": {
          "type": "integer",
          "minimum": 1
        },
        "authorized_by": {
          "type": "string",
          "const": "human"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "semantic_project_claim": {
      "type": "object",
      "required": [
        "decision_changes",
        "invariant_changes",
        "project_gap_changes",
        "selection_context_change",
        "evidence"
      ],
      "properties": {
        "decision_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_decision_change"
          }
        },
        "invariant_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_invariant_change"
          }
        },
        "project_gap_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_project_gap_change"
          }
        },
        "selection_context_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/selection_context"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "Record conclusions established by the selected Gap and actual unresolved impacts. Updating several targets for one conclusion is allowed; settling independent decisions is separate work."
    },
    "semantic_decision_change": {
      "type": "object",
      "required": [
        "area_ref",
        "set_decision",
        "reason",
        "evidence"
      ],
      "properties": {
        "area_ref": {
          "type": "string"
        },
        "set_decision": {
          "$ref": "#/$defs/software_decision"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "software_decision": {
      "type": "object",
      "required": [
        "status",
        "statement",
        "reason",
        "evidence",
        "confidence",
        "resume_condition"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "settled",
            "deferred",
            "stale"
          ]
        },
        "statement": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "resume_condition": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "semantic_invariant_change": {
      "type": "object",
      "required": [
        "action",
        "ref",
        "definition",
        "reason",
        "evidence"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add",
            "update",
            "retire",
            "sync_core"
          ]
        },
        "ref": {
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/semantic_invariant_definition"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "semantic_invariant_definition": {
      "type": "object",
      "required": [
        "applies_when",
        "must_hold",
        "evidence_expectation",
        "priority"
      ],
      "properties": {
        "applies_when": {
          "type": "string"
        },
        "must_hold": {
          "type": "string"
        },
        "evidence_expectation": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "required",
            "recommended",
            "informational"
          ]
        }
      },
      "additionalProperties": false
    },
    "semantic_project_gap_change": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "action",
            "ref",
            "gap",
            "reason",
            "evidence"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "add",
                "update"
              ]
            },
            "ref": {
              "type": "string"
            },
            "gap": {
              "$ref": "#/$defs/semantic_project_gap"
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action",
            "ref",
            "gap",
            "reason",
            "evidence"
          ],
          "properties": {
            "action": {
              "type": "string",
              "const": "resolve"
            },
            "ref": {
              "type": "string"
            },
            "gap": {
              "type": "null"
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "semantic_project_gap": {
      "type": "object",
      "required": [
        "goal",
        "reason",
        "affects",
        "priority_basis",
        "dependencies",
        "candidate_case_ref"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "priority_basis": {
          "$ref": "#/$defs/priority_basis"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_case_ref": {
          "type": "string",
          "enum": [
            "",
            "case:current"
          ]
        }
      },
      "additionalProperties": false
    },
    "selection_context": {
      "type": "object",
      "required": [
        "current_focus",
        "project_priorities"
      ],
      "properties": {
        "current_focus": {
          "type": "string"
        },
        "project_priorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "semantic_invariant_assessment": {
      "type": "object",
      "required": [
        "judgments"
      ],
      "properties": {
        "judgments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_invariant_judgment"
          }
        }
      },
      "additionalProperties": false,
      "description": "Assess every invariant without requiring all to be upheld in this round. Related unresolved obligations remain threatened or undetermined with open Gap references; assessment does not select additional work."
    },
    "semantic_invariant_judgment": {
      "$ref": "#/$defs/invariant_judgment"
    },
    "invariant_judgment": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "invariant_ref",
            "disposition",
            "reason",
            "fact_refs",
            "evidence",
            "gap_refs"
          ],
          "properties": {
            "invariant_ref": {
              "type": "string"
            },
            "disposition": {
              "type": "string",
              "const": "not_relevant"
            },
            "reason": {
              "type": "string"
            },
            "fact_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            },
            "gap_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "invariant_ref",
            "disposition",
            "reason",
            "fact_refs",
            "evidence",
            "gap_refs"
          ],
          "properties": {
            "invariant_ref": {
              "type": "string"
            },
            "disposition": {
              "type": "string",
              "const": "upheld"
            },
            "reason": {
              "type": "string"
            },
            "fact_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "gap_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "invariant_ref",
            "disposition",
            "reason",
            "fact_refs",
            "evidence",
            "gap_refs"
          ],
          "properties": {
            "invariant_ref": {
              "type": "string"
            },
            "disposition": {
              "type": "string",
              "enum": [
                "threatened",
                "undetermined"
              ]
            },
            "reason": {
              "type": "string"
            },
            "fact_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gap_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "case_control": {
      "anyOf": [
        {
          "$ref": "#/$defs/create_case_control"
        },
        {
          "$ref": "#/$defs/bind_closed_case_control"
        }
      ]
    },
    "create_case_control": {
      "type": "object",
      "required": [
        "action",
        "title",
        "intent",
        "expected_outcome",
        "artifact_type",
        "selection_reason",
        "initial_facts",
        "initial_impacts",
        "initial_gaps"
      ],
      "properties": {
        "action": {
          "type": "string",
          "const": "create_case"
        },
        "title": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "expected_outcome": {
          "type": "string"
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "code",
            "skill",
            "document",
            "workflow",
            "mixed",
            "unknown"
          ]
        },
        "selection_reason": {
          "type": "string"
        },
        "initial_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_fact"
          }
        },
        "initial_impacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/initial_semantic_impact"
          }
        },
        "initial_gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semantic_gap"
          }
        }
      },
      "additionalProperties": false
    },
    "initial_semantic_impact": {
      "type": "object",
      "required": [
        "ref",
        "fact_ref",
        "target_ref",
        "effect",
        "reason",
        "gap_refs",
        "evidence"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^local:impact:.+$"
        },
        "fact_ref": {
          "type": "string",
          "pattern": "^local:fact:.+$"
        },
        "target_ref": {
          "type": "string",
          "pattern": "^project:(decision|invariant):.+$"
        },
        "effect": {
          "type": "string",
          "enum": [
            "upheld",
            "threatened",
            "undetermined"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "gap_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^local:gap:.+$"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "bind_closed_case_control": {
      "type": "object",
      "required": [
        "action",
        "case_id",
        "expected_case_updated_at",
        "case_source_digest",
        "coverage_reason",
        "coverage_evidence"
      ],
      "properties": {
        "action": {
          "type": "string",
          "const": "bind_closed_case"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_case_updated_at": {
          "type": "string",
          "minLength": 1
        },
        "case_source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coverage_reason": {
          "type": "string",
          "minLength": 1
        },
        "coverage_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
