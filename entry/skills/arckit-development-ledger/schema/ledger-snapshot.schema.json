{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.local/schema/ledger-snapshot.schema.json",
  "title": "Arckit Ledger Snapshot Receipt",
  "type": "object",
  "required": ["schema_version", "protocol_revision", "state_availability", "observed_at", "snapshot_token", "observed_after_commit", "expected_after_commit_token", "compatibility", "source_digests", "project_revision", "case_revisions", "selection_tokens", "canonical", "candidate_catalog", "paths"],
  "properties": {
    "schema_version": { "const": "arckit-ledger-snapshot/v1" },
    "protocol_revision": { "type": "string", "minLength": 1 },
    "state_availability": { "type": "string", "enum": ["available", "unavailable"] },
    "observed_at": { "type": "string", "minLength": 1 },
    "snapshot_token": { "type": "string", "minLength": 1 },
    "observed_after_commit": { "type": "boolean" },
    "expected_after_commit_token": { "type": "string" },
    "compatibility": { "type": "object" },
    "source_digests": { "type": "object" },
    "project_revision": { "type": ["integer", "null"], "minimum": 0 },
    "case_revisions": { "type": "array" },
    "selection_tokens": { "type": "object" },
    "canonical": { "type": "object" },
    "candidate_catalog": {
      "type": "object",
      "required": ["persisted_candidates", "persisted_obligations"],
      "properties": {
        "persisted_candidates": { "type": "array" },
        "persisted_obligations": { "type": "array" }
      },
      "additionalProperties": false
    },
    "paths": { "type": "object" }
  },
  "additionalProperties": false
}
