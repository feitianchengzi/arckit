{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.local/schema/protocol-compatibility.schema.json",
  "title": "Arckit Ledger Protocol Compatibility",
  "type": "object",
  "required": ["schema_version", "status", "state_availability", "recovery_required", "recovery_mode", "expected", "observed", "affected_refs", "snapshot_token"],
  "properties": {
    "schema_version": { "const": "arckit-ledger-compatibility/v1" },
    "status": { "enum": ["compatible", "incompatible"] },
    "state_availability": { "enum": ["available", "unavailable"] },
    "recovery_required": { "type": "boolean" },
    "recovery_mode": { "enum": ["none", "protocol_reconciliation", "current_protocol_repair"] },
    "expected": {
      "type": "object",
      "required": ["project", "case", "iteration", "reconciliation"],
      "properties": {
        "project": { "const": "project-state-record/v5" },
        "case": { "const": "development-case-record/v5" },
        "iteration": { "const": "iteration-state-record/v3" },
        "reconciliation": { "const": "arckit-protocol-reconciliation/v1" }
      },
      "additionalProperties": false
    },
    "observed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "kind", "schema_version", "expected_schema_version", "condition", "source_digest", "issues"],
        "properties": {
          "ref": { "type": "string" },
          "kind": { "enum": ["project", "case", "iteration"] },
          "schema_version": { "type": "string" },
          "expected_schema_version": { "type": "string" },
          "condition": { "enum": ["compatible", "older_protocol", "newer_protocol", "unknown_protocol", "missing_schema_version", "current_protocol_invalid", "missing", "unreadable"] },
          "source_digest": { "type": "string" },
          "issues": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "affected_refs": { "type": "array", "items": { "type": "string" } },
    "snapshot_token": { "type": "string" }
  },
  "additionalProperties": false
}
