{
  "schema_version": "arckit-capability/v1",
  "id": "arckit-visual",
  "kind": "result_fact_source",
  "runtime_role": ["route_auditor", "work_executor", "verification_agent"],
  "binding_targets": ["worker"],
  "summary": "Maintains stable visual strategy, design tokens, themes, and component visual specifications.",
  "input_facts": [
    "confirmed_visual_expectation",
    "existing_visual_strategy",
    "human_visual_decision"
  ],
  "outputs": [
    "visual_update",
    "visual_audit",
    "visual_acceptance_criteria"
  ],
  "allowed_write_targets": [
    "arckit/visual/**"
  ],
  "forbidden_decisions": [
    "brand_direction_without_human_basis",
    "aesthetic_approval",
    "product_or_technical_fact_ownership"
  ],
  "runtime_notes": [
    "Use only when visual direction has an explicit human or stable fact basis; otherwise create a human gate in the active case."
  ]
}
