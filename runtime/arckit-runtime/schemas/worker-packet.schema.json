{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.local/schema/worker-packet.schema.json",
  "title": "Arckit Worker Packet",
  "type": "object",
  "required": ["schema_version", "worker_id", "worker_type", "role", "task", "case_context", "expected_case_impact", "context_refs", "allowed_actions", "forbidden_actions", "allowed_paths", "allowed_skills", "expected_report_schema", "stop_condition"],
  "properties": {
    "schema_version": { "type": "string", "const": "arckit-worker-packet/v2" },
    "worker_id": { "type": "string" },
    "worker_type": { "type": "string", "enum": ["product", "tech", "implementation", "verification", "diagnosis", "closeout"] },
    "role": { "type": "string", "minLength": 1 },
    "task": { "type": "string" },
    "case_context": {
      "type": "object",
      "required": ["case_id", "case_updated_at", "selected_gap"],
      "properties": {
        "case_id": { "type": "string" },
        "case_updated_at": { "type": "string", "minLength": 1 },
        "selected_gap": { "type": "object" }
      },
      "additionalProperties": false
    },
    "expected_case_impact": { "type": "string", "minLength": 1 },
    "context_refs": { "type": "array", "items": { "type": "string" } },
    "allowed_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "allowed_skills": { "type": "array", "items": { "type": "string" } },
    "expected_report_schema": { "type": "string", "const": "arckit-worker-report/v2" },
    "stop_condition": { "type": "string" }
  },
  "additionalProperties": false
}
