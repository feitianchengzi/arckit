{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.local/schema/agent-loop-result.schema.json",
  "title": "Arckit Coherent Agent Loop Result",
  "type": "object",
  "required": [
    "schema_version",
    "action",
    "summary",
    "case_control",
    "case_command",
    "changed_files",
    "artifact_impacts",
    "risks",
    "unknowns",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "arckit-agent-loop-result/v2"
    },
    "action": {
      "type": "string",
      "enum": [
        "case_control",
        "case_command",
        "handoff"
      ]
    },
    "summary": {
      "type": "string"
    },
    "case_control": {
      "anyOf": [
        {
          "$ref": "arckit-contract:case_control"
        },
        {
          "type": "null"
        }
      ]
    },
    "case_command": {
      "anyOf": [
        {
          "$ref": "arckit-contract:case_command"
        },
        {
          "type": "null"
        }
      ]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_impacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_impact"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "$ref": "#/$defs/handoff"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact_impact": {
      "type": "object",
      "required": [
        "path",
        "claim",
        "summary"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "description": "Execution disposition: a standalone handoff with next_responsibility=none stops execution without claiming Case completion. Only trusted Ledger acceptance establishes Case completion. human requests a human decision; external waits for an external result; agent continues the State Driven Loop.",
      "type": "object",
      "required": [
        "next_responsibility",
        "reason",
        "next_prompt",
        "human_decision_required"
      ],
      "properties": {
        "next_responsibility": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "external",
            "none"
          ]
        },
        "reason": {
          "type": "string"
        },
        "next_prompt": {
          "type": "string"
        },
        "human_decision_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
