        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["error", "omission", "excess"] },
        "statement": { "type": "string" },
        "responsibility": { "type": "string", "enum": ["agent", "human", "external"] },
        "artifact_refs": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "review_budget_extension": {
      "type": "object",
      "required": ["additional_cycles", "authorized_by", "reason", "evidence"],
