        "goal": { "type": "string" }, "reason": { "type": "string" },
        "derived_from": { "type": "array", "items": { "type": "string" } },
        "blocked_by": { "type": "array", "items": { "type": "string" } },
        "priority_basis": { "$ref": "#/$defs/priority_basis" }, "responsibility": { "type": "string", "enum": ["agent", "human", "external"] },
        "evidence_required": { "type": "array", "items": { "type": "string" } }, "resolution": { "anyOf": [{ "$ref": "#/$defs/gap_resolution" }, { "type": "null" }] }
