        "authorized_by": { "type": "string", "const": "human" },
        "reason": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "selection_context": {
      "type": "object",
      "required": ["current_focus", "project_priorities"],
      "properties": {
        "current_focus": { "type": "string" },
        "project_priorities": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "project_target_ref": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["software_decision", "software_invariant", "project_intent"] },
        "ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "project_gap": {
      "type": "object",
      "required": ["id", "goal", "reason", "affects", "priority_basis", "dependencies", "candidate_case_ref"],
      "properties": {
        "id": { "type": "string" }, "goal": { "type": "string" }, "reason": { "type": "string" },
        "affects": { "type": "array", "items": { "$ref": "#/$defs/project_target_ref" }, "minItems": 1 },
        "priority_basis": { "$ref": "#/$defs/priority_basis" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "candidate_case_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifact_impact": {
      "type": "object",
      "required": ["path", "claim", "summary"],
      "properties": { "path": { "type": "string" }, "claim": { "type": "string" }, "summary": { "type": "string" } },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["next_responsibility", "reason", "next_prompt", "human_decision_required"],
