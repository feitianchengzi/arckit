        "next_responsibility": { "type": "string", "enum": ["agent", "human", "external", "none"] },
        "reason": { "type": "string" }, "next_prompt": { "type": "string" }, "human_decision_required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
