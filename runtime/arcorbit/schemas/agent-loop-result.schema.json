        "reason": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "software_invariant_change": {
      "type": "object",
      "required": ["action", "invariant", "reason", "evidence"],
      "properties": {
        "action": { "type": "string", "enum": ["add", "update", "retire", "sync_core"] },
        "invariant": { "$ref": "#/$defs/software_invariant" },
        "reason": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "project_gap_change": {
      "type": "object",
      "required": ["action", "gap", "gap_id", "reason", "evidence"],
      "properties": {
        "action": { "type": "string", "enum": ["add", "update", "resolve"] },
        "gap": { "anyOf": [{ "$ref": "#/$defs/project_gap" }, { "type": "null" }] }, "gap_id": { "type": "string" },
        "reason": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "software_decision": {
      "type": "object",
      "required": ["status", "statement", "reason", "evidence", "confidence", "resume_condition"],
      "properties": {
        "status": { "type": "string", "enum": ["open", "settled", "deferred", "stale"] },
        "statement": { "type": "string" }, "reason": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] }, "resume_condition": { "type": "string" }
      },
      "additionalProperties": false
    },
    "software_invariant": {
      "type": "object",
      "required": ["id", "applies_when", "must_hold", "evidence_expectation", "priority"],
      "properties": {
        "id": { "type": "string" }, "applies_when": { "type": "string" },
        "must_hold": { "type": "string" }, "evidence_expectation": { "type": "string" },
        "priority": { "type": "string", "enum": ["required", "recommended", "informational"] }
      },
      "additionalProperties": false
    },
    "completion_review_result": {
      "type": "object",
      "required": ["outcome", "reviewer", "reviewed_content_revision", "dimensions", "findings", "evidence"],
      "properties": {
        "outcome": { "type": "string", "enum": ["clean", "findings", "needs_human"] },
        "reviewer": { "type": "string", "enum": ["agent", "human"] },
        "reviewed_content_revision": { "type": "integer", "minimum": 0 },
        "dimensions": { "$ref": "#/$defs/review_dimensions" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/review_finding" } },
        "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "review_dimensions": {
      "type": "object",
      "required": ["implementation_correctness", "problem_resolution", "verification_credibility", "regression_risk", "minimality"],
      "properties": {
        "implementation_correctness": { "type": "string", "enum": ["clean", "findings"] },
        "problem_resolution": { "type": "string", "enum": ["clean", "findings"] },
        "verification_credibility": { "type": "string", "enum": ["clean", "findings"] },
        "regression_risk": { "type": "string", "enum": ["clean", "findings"] },
        "minimality": { "type": "string", "enum": ["clean", "findings"] }
      },
      "additionalProperties": false
    },
    "review_finding": {
      "type": "object",
      "required": ["id", "kind", "statement", "responsibility", "artifact_refs", "evidence"],
