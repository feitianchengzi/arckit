{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.local/schema/project-state-record.schema.json",
  "title": "Arckit Project State Record",
  "type": "object",
  "required": ["schema_version", "project", "advancement", "software_definition", "software_invariants"],
  "properties": {
    "schema_version": { "const": "project-state-record/v5" },
    "project": {
      "type": "object",
      "required": ["name", "status", "intent", "created_at", "updated_at", "revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "paused", "archived"] },
        "intent": { "type": "string" },
        "created_at": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "advancement": {
      "type": "object",
      "required": ["active_iteration_ref", "active_case_refs", "project_gaps", "selection_context"],
      "properties": {
        "active_iteration_ref": { "type": "string" },
        "active_case_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "project_gaps": { "type": "array", "items": { "$ref": "#/$defs/project_gap" } },
        "selection_context": {
          "type": "object",
          "required": ["current_focus", "project_priorities"],
          "properties": {
            "current_focus": { "type": "string" },
            "project_priorities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "software_definition": {
      "type": "object",
      "required": ["summary", "decision_areas"],
      "properties": {
        "summary": { "type": "string" },
        "decision_areas": { "type": "array", "items": { "$ref": "#/$defs/decision_area" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "software_invariants": {
      "type": "array",
      "items": { "$ref": "#/$defs/software_invariant" },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "decision_area": {
      "type": "object",
      "required": ["id", "question", "decision_expectation", "evidence_expectation", "decision", "gap_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "question": { "type": "string", "minLength": 1 },
        "decision_expectation": { "type": "string", "minLength": 1 },
        "evidence_expectation": { "type": "string", "minLength": 1 },
        "decision": { "$ref": "#/$defs/software_decision" },
        "gap_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "software_decision": {
      "type": "object",
      "required": ["revision", "status", "statement", "reason", "evidence", "confidence", "resume_condition"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["open", "settled", "deferred", "stale"] },
        "statement": { "type": "string" },
        "reason": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "resume_condition": { "type": "string" }
      },
      "additionalProperties": false
    },
    "software_invariant": {
      "type": "object",
      "required": ["id", "applies_when", "must_hold", "evidence_expectation", "priority"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "applies_when": { "type": "string", "minLength": 1 },
        "must_hold": { "type": "string", "minLength": 1 },
        "evidence_expectation": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "enum": ["required", "recommended", "informational"] }
      },
      "additionalProperties": false
    },
    "project_target_ref": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["software_decision", "software_invariant", "project_intent"] },
        "ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "project_gap": {
      "type": "object",
      "required": ["id", "goal", "reason", "affects", "priority_basis", "dependencies", "candidate_case_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "affects": { "type": "array", "items": { "$ref": "#/$defs/project_target_ref" }, "minItems": 1 },
        "priority_basis": { "type": "object", "minProperties": 1 },
        "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "candidate_case_ref": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
