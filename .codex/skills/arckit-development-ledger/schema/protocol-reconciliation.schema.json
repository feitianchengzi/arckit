{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arckit.local/schema/protocol-reconciliation.schema.json",
  "title": "Arckit Ledger Protocol Reconciliation",
  "type": "object",
  "required": ["schema_version", "observed_snapshot_token", "reason", "evidence", "preservation_claims", "replacements"],
  "properties": {
    "schema_version": { "const": "arckit-protocol-reconciliation/v1" },
    "observed_snapshot_token": { "type": "string" },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "preservation_claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "kind", "observed_schema_version", "target_schema_version", "source_digest", "record", "semantic_basis", "uncertainties"],
        "properties": {
          "ref": { "type": "string" },
          "kind": { "enum": ["project", "case", "iteration"] },
          "observed_schema_version": { "type": "string" },
          "target_schema_version": { "type": "string" },
          "source_digest": { "type": "string" },
          "record": { "type": "object" },
          "semantic_basis": { "type": "string", "minLength": 1 },
          "uncertainties": { "type": "array", "items": { "type": "string" }, "maxItems": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
