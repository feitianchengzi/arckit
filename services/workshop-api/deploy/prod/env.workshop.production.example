# 生产环境统一配置
# 在本地复制此文件为 .env.workshop.production 并配置实际值
# 注意：.env.workshop.production 文件不要提交到 Git，包含敏感信息

# 环境标识
ENV=production

# 服务配置
PORT=8081
HOST=0.0.0.0
SERVICE_NAME=workshop

# 服务URL（生产环境）
BASE_URL=https://api.example.com

# 数据库配置（RDS 远程数据库）
# 注意：部署时需要填写实际的数据库密码
DB_HOST=pgm-2ze8p2i2ex9c298bro.pg.rds.aliyuncs.com
DB_PORT=5432
DB_USER=workshop
DB_PASSWORD=password
DB_NAME=workshop
DB_SSLMODE=disable
# 生产发布由 remote-deploy.sh 在切换流量前显式执行 ./todo migrate。
# 普通服务启动仍会验证必需 schema；关闭隐式迁移可避免迁移时序不透明。
DB_AUTO_MIGRATE=false

# 跨域配置（生产环境只允许特定的域名）
CORS_ALLOW_ORIGINS=https://app.example.com,https://www.example.com

# 日志级别（生产环境使用 info 或 warn）
LOG_LEVEL=info

# 生产服务器
PROD_SERVER_HOST=your-server-host.example.com
PROD_SERVER_PRIVATE_IP=172.17.0.0
PROD_SERVER_PORT=443
PROD_SERVER_PROTOCOL=https
PROD_SERVER_SSH_USER=your-username
PROD_SERVER_SSH_PORT=22
PROD_SERVER_SSH_KEY_PATH=~/.ssh/id_ed25519

# 部署目录
SERVER_DEPLOY_DIR=/opt/todo

# Docker 镜像配置
IMAGE_NAME=todo-service
IMAGE_TAG=latest

# 项目根目录（相对于 deploy/prod/）
PROJECT_ROOT=../..

# 阿里云 OSS AccessKey ID
OSS_ACCESS_KEY_ID=REPLACE_WITH_PRIVATE_SECRET

# 阿里云 OSS AccessKey Secret
OSS_ACCESS_KEY_SECRET=REPLACE_WITH_PRIVATE_SECRET

# OSS 区域（用于STS服务，通常与Bucket区域一致）
OSS_REGION=cn-beijing

# OSS Bucket 名称
OSS_BUCKET_NAME=myoss

# OSS RAM 角色 ARN（用于STS临时凭证）
# 格式：acs:ram::{AccountID}:role/{RoleName}
# 示例：acs:ram::1234567890123456:role/oss-role
OSS_RAM_ROLE_ARN=acs:ram::YOUR_ACCOUNT_ID:role/YOUR_ROLE_NAME

# OSS RootPath 允许操作的根目录路径
OSS_ROOT_PATH=/workshop

# V2 反馈会话认证。网关与 Workshop 必须使用相同的值，且两者应不同。
# 通过 `openssl rand -base64 48` 生成；不要提交真实值。
FEEDBACK_SESSION_SIGNING_KEY=REPLACE_WITH_PRIVATE_SECRET
FEEDBACK_GATEWAY_SHARED_SECRET=REPLACE_WITH_PRIVATE_SECRET
