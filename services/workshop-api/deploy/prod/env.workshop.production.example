# 生产环境统一配置
# 在本地复制此文件为 .env.workshop.production 并配置实际值
# 注意：.env.workshop.production 文件不要提交到 Git，包含敏感信息

# 环境标识
ENV=production

# 服务配置
PORT=8081
HOST=0.0.0.0
SERVICE_NAME=workshop

# 服务URL（生产环境）
BASE_URL=https://api.example.com

# 数据库配置（RDS 远程数据库）
# 注意：部署时需要填写实际的数据库密码
DB_HOST=pgm-2ze8p2i2ex9c298bro.pg.rds.aliyuncs.com
DB_PORT=5432
DB_USER=workshop
DB_PASSWORD=password
DB_NAME=workshop
DB_SSLMODE=disable
# 生产发布由 remote-deploy.sh 在切换流量前显式执行 ./todo migrate。
# 普通服务启动仍会验证必需 schema；关闭隐式迁移可避免迁移时序不透明。
DB_AUTO_MIGRATE=false
# remote-deploy.sh writes a verified custom-format dump here before every migration.
DEPLOY_BACKUP_DIR=/opt/todo/backups

# 跨域配置（生产环境只允许特定的域名）
CORS_ALLOW_ORIGINS=https://app.example.com,https://www.example.com

# 日志级别（生产环境使用 info 或 warn）
LOG_LEVEL=info

# 生产服务器
PROD_SERVER_HOST=your-server-host.example.com
PROD_SERVER_PRIVATE_IP=172.17.0.0
PROD_SERVER_PORT=443
PROD_SERVER_PROTOCOL=https
PROD_SERVER_SSH_USER=your-username
PROD_SERVER_SSH_PORT=22
PROD_SERVER_SSH_KEY_PATH=~/.ssh/id_ed25519

# 部署目录
SERVER_DEPLOY_DIR=/opt/todo

# Docker 镜像配置
IMAGE_NAME=todo-service
IMAGE_TAG=latest
# 本地 Mac 构建限额；builder 使用本机架构交叉编译 linux/amd64，避免 QEMU 全程模拟。
LOCAL_BUILD_MODE=host
LOCAL_BUILD_GOMAXPROCS=2
LOCAL_BUILD_PARALLELISM=2
LOCAL_BUILD_MEMORY_LIMIT=768MiB

# 项目根目录（相对于 deploy/prod/）
PROJECT_ROOT=../..

# 阿里云 OSS AccessKey ID
OSS_ACCESS_KEY_ID=REPLACE_WITH_PRIVATE_SECRET

# 阿里云 OSS AccessKey Secret
OSS_ACCESS_KEY_SECRET=REPLACE_WITH_PRIVATE_SECRET

# OSS 区域（用于STS服务，通常与Bucket区域一致）
OSS_REGION=cn-beijing

# OSS Bucket 名称
OSS_BUCKET_NAME=myoss

# OSS RAM 角色 ARN（用于STS临时凭证）
# 格式：acs:ram::{AccountID}:role/{RoleName}
# 示例：acs:ram::1234567890123456:role/oss-role
OSS_RAM_ROLE_ARN=acs:ram::YOUR_ACCOUNT_ID:role/YOUR_ROLE_NAME

# OSS RootPath 允许操作的根目录路径
OSS_ROOT_PATH=/workshop

# V2 反馈会话认证。网关与 Workshop 必须使用相同的值，且两者应不同。
# 通过 `openssl rand -base64 48` 生成；不要提交真实值。
FEEDBACK_SESSION_SIGNING_KEY=REPLACE_WITH_PRIVATE_SECRET
FEEDBACK_GATEWAY_SHARED_SECRET=REPLACE_WITH_PRIVATE_SECRET
# Console 自反馈项目。仅 user 路由可免项目成员校验，身份由登录用户 ID 派生。
FEEDBACK_CONSOLE_PROJECT_ID=

# 项目成员反馈邮件订阅。默认关闭，完成数据库迁移并配置网关内部密钥后再开启。
FEEDBACK_EMAIL_NOTIFICATIONS_ENABLED=false
FEEDBACK_NOTIFICATION_EMAIL_URL=http://host.docker.internal:4433/v1/internal/notification-emails
FEEDBACK_NOTIFICATION_SHARED_SECRET=REPLACE_WITH_A_SEPARATE_AT_LEAST_32_BYTE_SECRET
FEEDBACK_CONSOLE_BASE_URL=https://feedback.feitianchengzi.com/console
FEEDBACK_EMAIL_POLL_INTERVAL=5s
FEEDBACK_EMAIL_REQUEST_TIMEOUT=12s
FEEDBACK_EMAIL_MAX_ATTEMPTS=8

# 待办事务邮件。网关位于同一 ECS 时填写宿主机私网地址或可解析的内部地址。
TASK_NOTIFICATION_EMAILS_ENABLED=true
TASK_NOTIFICATION_EMAIL_ENDPOINT=http://ecs-private-ip.invalid:4433/v1/internal/notification-emails
# 必须与 nebula-auth 的 NOTIFICATION_INTERNAL_SHARED_SECRET 一致，至少 32 字符。
# 迁移期未设置时会兼容读取现有 FEEDBACK_NOTIFICATION_SHARED_SECRET。
NOTIFICATION_INTERNAL_SHARED_SECRET=REPLACE_WITH_PRIVATE_SECRET
WORKSHOP_WEB_URL=https://workshop.feitianchengzi.com

# OpenHands is deployed as an internal-only optional service. Keep the Workshop
# feature gate off until the container, project configuration, and canary pass.
OPENHANDS_ENABLED=false
# Pin the tested image by digest; never use latest in production.
OPENHANDS_IMAGE=ghcr.io/openhands/agent-server:1.54.0-python@sha256:082368832a7e48087b64da38c7b2cf2442dd7621fde69f8d06ed52283ff136f8
# Generate both independently with: openssl rand -base64 48
OH_SESSION_API_KEYS_0=REPLACE_WITH_A_STABLE_AT_LEAST_32_BYTE_SECRET
OH_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_STABLE_AT_LEAST_32_BYTE_SECRET
# Generated once by prepare-openhands-env.sh. Workshop uses it only to encrypt
# project-owned model keys saved from the authenticated Console.
OPENHANDS_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_STABLE_AT_LEAST_32_BYTE_SECRET

# Workshop sends this LLM configuration on each Agent Server request. The server
# fallback key may stay empty: requests use local retrieval until an owner/admin
# saves a project key in Feedback Console. Adding a server key later requires only
# recreating todo-service; no SDK rebuild is required.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek/deepseek-chat

# One host directory is mounted read-write by Workshop and read-only by OpenHands.
CUSTOMER_REPOS_PATH=/opt/todo/customer-repos
OH_REPO_ROOT=/workspace/customer-repos
OH_WORKSPACE_DIR=/workspace/customer-repos
OH_SHARED_GID=2000

# Conservative limits for the current 2-core / 3.5-GiB production host.
WORKSHOP_CPU_LIMIT=0.5
WORKSHOP_MEMORY_LIMIT=384M
OPENHANDS_CPU_LIMIT=1.0
OPENHANDS_MEMORY_LIMIT=1536M
OPENHANDS_MIN_AVAILABLE_MB=1536
# The control script refuses to start OpenHands without this swap safety margin.
OPENHANDS_MIN_SWAP_MB=2048
