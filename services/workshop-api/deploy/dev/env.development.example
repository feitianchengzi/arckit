# 开发环境配置
# 复制此文件为 .env.development 并根据实际情况修改

# 环境标识
ENV=development

# 服务配置
PORT=8081
HOST=0.0.0.0
SERVICE_NAME=todo

# 服务URL（本地开发）
BASE_URL=http://localhost:8081

# 数据库配置
# 注意：
# - 如果使用 Docker 运行（docker-compose.dev.yml），DB_HOST 会自动设置为 postgres（Docker 服务名）
# - 如果本地直接运行（go run main.go），使用 localhost 连接到本地 PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todo
DB_SSLMODE=disable

# 跨域配置（开发环境允许所有本地来源）
CORS_ALLOW_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1

# 日志级别
LOG_LEVEL=debug

# V2 反馈会话认证。本地网关与 Workshop 必须使用相同的值，且两者应不同。
FEEDBACK_SESSION_SIGNING_KEY=development-feedback-session-signing-key-32-bytes
FEEDBACK_GATEWAY_SHARED_SECRET=development-feedback-gateway-secret-32-bytes
# Console 自反馈项目。仅 user 路由可免项目成员校验，身份由登录用户 ID 派生。
FEEDBACK_CONSOLE_PROJECT_ID=

# 项目成员反馈邮件订阅。默认关闭，完成数据库迁移并配置网关内部密钥后再开启。
FEEDBACK_EMAIL_NOTIFICATIONS_ENABLED=false
FEEDBACK_NOTIFICATION_EMAIL_URL=http://host.docker.internal:4433/v1/internal/notification-emails
FEEDBACK_NOTIFICATION_SHARED_SECRET=replace_with_a_separate_secret_at_least_32_bytes
FEEDBACK_CONSOLE_BASE_URL=https://feedback.feitianchengzi.com/console
FEEDBACK_EMAIL_POLL_INTERVAL=5s
FEEDBACK_EMAIL_REQUEST_TIMEOUT=12s
FEEDBACK_EMAIL_MAX_ATTEMPTS=8

# 待办事务邮件。Workshop 只向受控网关模板发送用户 UUID，不接收任意邮箱或 HTML。
TASK_NOTIFICATION_EMAILS_ENABLED=false
TASK_NOTIFICATION_EMAIL_ENDPOINT=http://host.docker.internal:4433/v1/internal/notification-emails
NOTIFICATION_INTERNAL_SHARED_SECRET=development-notification-email-secret-32-bytes
WORKSHOP_WEB_URL=http://localhost:5173
